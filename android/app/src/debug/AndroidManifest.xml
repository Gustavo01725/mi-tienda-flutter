<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Solo en debug/profile: permite http:// para probar contra la web local
         (emulador: http://10.0.2.2:8000). Android 9+ lo bloquea por defecto y la app
         solo vería "Sin conexión". La compilación release sigue exigiendo HTTPS. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
